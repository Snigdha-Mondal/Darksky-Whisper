# DarkSky Whisper Environment Configuration Example
# Copy this file to .env and configure your keys.

# Environment
APP_ENV=development
PORT=8000
HOST=0.0.0.0

# ElevenLabs Voice API (TTS)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Google Gemma-2 Inference / HuggingFace Token
HUGGINGFACE_TOKEN=
GEMMA_MODEL_ID=google/gemma-2-2b-it

# Prior Labs TabPFN
TABPFN_API_KEY=

# Sentry Tracing & Telemetry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Thinking Machines Tinker API (LoRA Fine-Tuning)
TINKER_API_KEY=

# Local Storage / Cache
EPHEMERIS_DIR=./data/ephemeris
